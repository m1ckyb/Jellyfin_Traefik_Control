# Container Settings
PUID=1000
PGID=1000
TZ=UTC

# Cloudflare Settings
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ZONE_ID=your_cloudflare_zone_id_here
DOMAIN_ROOT=your_domain_here.com
ORIGIN_RULE_NAME=your_origin_rule_name_here

# Traefik / Redis Settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=
ROUTER_NAME=your_router_name_here
SERVICE_NAME=your_service_name_here
TARGET_INT_URL=http://192.168.1.100:8080

# === UNIFI CONTROLLER ===
UNIFI_HOST=192.168.1.1
UNIFI_USER=your_unifi_username_here
UNIFI_PASS=your_unifi_password_here
UNIFI_RULE_NAME=your_firewall_rule_name_here
